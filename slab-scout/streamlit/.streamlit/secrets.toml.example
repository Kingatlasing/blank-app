# Copy to .streamlit/secrets.toml (locally) or paste into Streamlit Cloud → App → Settings → Secrets.
# Everything here is optional.

# Shared community catalog + vault that syncs across devices (free Supabase project)
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# Pre-fill a free Gemini key so you don't paste it each visit (optional)
# GEMINI_API_KEY = "AIza..."
